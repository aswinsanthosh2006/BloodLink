#include <ESP8266WiFi.h>
#include <ESP8266HTTPClient.h>
#include <WiFiClientSecureBearSSL.h>
#include <ArduinoJson.h>
#include <DHT.h>

// ---------- CONFIGURATION ----------
const char* WIFI_SSID = "Enter wifi name";
const char* WIFI_PASSWORD = "Enter password for wifi";

const char* ENDPOINT =
  "https://ycacfjmizaoegykxrtfl.supabase.co/functions/v1/device-ingest";

const char* DEVICE_CODE = "ESP8266-SENSOR-01";

// Paste the value of SENSOR_DEVICE_SECRET here, privately.
const char* DEVICE_SECRET = "Enter secret code";

// ---------- HARDWARE ----------
#define DHTPIN D1
#define DHTTYPE DHT11
#define IR1 D2
#define IR2 D5

DHT dht(DHTPIN, DHTTYPE);

unsigned long lastUpload = 0;
const unsigned long UPLOAD_INTERVAL = 30000;

void connectWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.print("Connecting to Wi-Fi...");
  unsigned long started = millis();

  while (WiFi.status() != WL_CONNECTED &&
         millis() - started < 20000) {
    delay(300);
    Serial.print(".");
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWi-Fi connected");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\nWi-Fi connection timed out");
  }
}

bool sendSensorData(float temp, float humidity,
                    bool slot1, bool slot2) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("No Wi-Fi; upload skipped");
    return false;
  }

  BearSSL::WiFiClientSecure client;

  // Temporary connectivity test only.
  // Replace with certificate verification before final deployment.
  client.setInsecure();

  HTTPClient http;

  if (!http.begin(client, ENDPOINT)) {
    Serial.println("HTTPS initialization failed");
    return false;
  }

  http.setTimeout(10000);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("x-device-code", DEVICE_CODE);
  http.addHeader("x-device-secret", DEVICE_SECRET);

  JsonDocument doc;
  doc["type"] = "sensor_reading";
  doc["temperature_c"] = temp;
  doc["humidity_pct"] = humidity;

  JsonArray slots = doc["slots"].to<JsonArray>();

  JsonObject s1 = slots.add<JsonObject>();
  s1["sensor_id"] = "IR-01";
  s1["occupied"] = slot1;

  JsonObject s2 = slots.add<JsonObject>();
  s2["sensor_id"] = "IR-02";
  s2["occupied"] = slot2;

  String payload;
  serializeJson(doc, payload);

  Serial.println("Sending sensor data...");
  int status = http.POST(payload);

  Serial.printf("HTTP status: %d\n", status);

  if (status > 0) {
    Serial.println(http.getString());
  } else {
    Serial.println(http.errorToString(status));
  }

  http.end();
  return status >= 200 && status < 300;
}

void setup() {
  Serial.begin(115200);
  delay(500);

  pinMode(IR1, INPUT);
  pinMode(IR2, INPUT);
  dht.begin();

  connectWiFi();
}

void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }

  if (millis() - lastUpload < UPLOAD_INTERVAL &&
      lastUpload != 0) {
    delay(20);
    return;
  }

  lastUpload = millis();

  float temp = dht.readTemperature();
  float humidity = dht.readHumidity();

  bool slot1 = (digitalRead(IR1) == LOW);
  bool slot2 = (digitalRead(IR2) == LOW);

  Serial.println("\n--- BloodLink sensors ---");

  if (isnan(temp) || isnan(humidity)) {
    Serial.println("DHT reading invalid; not uploading");
    return;
  }

  Serial.printf("Temperature: %.2f C\n", temp);
  Serial.printf("Humidity: %.2f %%\n", humidity);
  Serial.printf("Slot 1: %s\n", slot1 ? "OCCUPIED" : "EMPTY");
  Serial.printf("Slot 2: %s\n", slot2 ? "OCCUPIED" : "EMPTY");

  sendSensorData(temp, humidity, slot1, slot2);
}
